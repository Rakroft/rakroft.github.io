---
// Barra fija en el borde derecho con los contactos (visible desde tablet en adelante).
import Icon from './Icon.astro';
import { contact } from '../data/contact';

const links = [
  { href: contact.github, label: 'GitHub', icon: 'github' as const, external: true },
  { href: contact.linkedin, label: 'LinkedIn', icon: 'linkedin' as const, external: true },
  { href: `mailto:${contact.email}`, label: 'Email', icon: 'mail' as const, external: false },
];
---

<aside
  class="fixed right-5 top-1/2 z-30 hidden -translate-y-1/2 flex-col items-center gap-5 md:flex lg:right-8"
  aria-label="Contacto"
>
  <span class="h-20 w-px bg-line"></span>
  <ul class="flex flex-col items-center gap-4">
    {links.map((l) => (
      <li>
        <a
          href={l.href}
          aria-label={l.label}
          title={l.label}
          {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
          class="grid size-9 place-items-center rounded-full text-muted transition duration-200 hover:-translate-y-0.5 hover:bg-ink/5 hover:text-ink"
        >
          <Icon name={l.icon} class="size-[18px]" />
        </a>
      </li>
    ))}
  </ul>
  <span class="h-6 w-px bg-line"></span>
  <a
    href={`mailto:${contact.email}`}
    class="text-[11px] tracking-[0.2em] text-muted transition-colors [writing-mode:vertical-rl] hover:text-ink"
  >{contact.email}</a>
  <span class="h-20 w-px bg-line"></span>
</aside>
