---
import Icon from './Icon.astro';
import { contact } from '../data/contact';
import { useT, homePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-3 md:pl-16 md:pr-28">
    <div>
      <p class="font-serif text-2xl">{contact.name}</p>
      <p class="mt-2 text-sm text-muted">{t.footer.built}</p>
      <p class="mt-1 text-sm text-muted">© {year}</p>
    </div>

    <ul class="space-y-2 text-sm">
      <li>
        <a href={`mailto:${contact.email}`} class="link-line inline-flex items-center gap-2 pb-0.5">
          <Icon name="mail" class="size-4" />{contact.email}
        </a>
      </li>
      <li>
        <a href={contact.github} target="_blank" rel="noopener" class="link-line inline-flex items-center gap-2 pb-0.5">
          <Icon name="github" class="size-4" />github.com/Rakroft
        </a>
      </li>
      <li>
        <a href={contact.linkedin} target="_blank" rel="noopener" class="link-line inline-flex items-center gap-2 pb-0.5">
          <Icon name="linkedin" class="size-4" />LinkedIn
        </a>
      </li>
    </ul>

    <div class="flex items-start justify-between gap-6 md:flex-col md:items-end">
      <div class="flex gap-3 text-xs uppercase tracking-wide">
        <a href={homePath('es')} hreflang="es" class:list={[lang === 'es' ? 'font-semibold' : 'text-muted hover:text-ink']}>Español</a>
        <a href={homePath('en')} hreflang="en" class:list={[lang === 'en' ? 'font-semibold' : 'text-muted hover:text-ink']}>English</a>
      </div>
      <a href="#top" class="link-line inline-flex items-center gap-1.5 pb-0.5 text-sm">
        {t.footer.top}<Icon name="arrow-up" class="size-4" />
      </a>
    </div>
  </div>
</footer>
